PORT=3000
JWT_SECRET=your_jwt_secret_key_here

# Option 1: Brevo HTTPS API (Recommended for Render - 100% Reliable, 300 free emails/day)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Option 2: SMTP Configuration (Brevo / Gmail / Custom SMTP)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=your_email@domain.com
EMAIL_PASSWORD=your_smtp_key_or_app_password

# MySQL / TiDB Database Configuration
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=technova
DB_PORT=4000
DB_SSL=true
